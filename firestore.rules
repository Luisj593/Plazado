rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Browser clients use the authenticated application API. Firebase Admin
    // on the server uses IAM and does not depend on these client rules.
    // Sensitive documents must never be exposed through direct client reads.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
