rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      return isAuthenticated() && (
        request.auth.token.role == 'SUPER_ADMIN' ||
        request.auth.token.email == 'admin@plazado.com' ||
        request.auth.token.email == 'contacto@plazado.com'
      );
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isStoreOwner(storeId) {
      return isAuthenticated() && (
        request.auth.token.storeId == storeId ||
        request.auth.token.role == 'SUPER_ADMIN'
      );
    }

    // Public catalog (Categories, Banners, Public Settings)
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    match /banners/{bannerId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    match /systemSettings/{settingId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    // Products: public read, store owner or super admin can write
    match /products/{productId} {
      allow read: if true;
      allow create: if isAuthenticated() && (request.resource.data.storeId == request.auth.token.storeId || isSuperAdmin());
      allow update, delete: if isAuthenticated() && (resource.data.storeId == request.auth.token.storeId || isSuperAdmin());
    }

    // Stores: public read, only owner or super admin can edit
    match /stores/{storeId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update: if isStoreOwner(storeId) || isSuperAdmin();
      allow delete: if isSuperAdmin();
    }

    // Users: only owner or super admin can read/update
    match /users/{userId} {
      allow read: if isOwner(userId) || isSuperAdmin();
      allow create: if true;
      allow update: if isOwner(userId) || isSuperAdmin();
      allow delete: if isSuperAdmin();
    }

    // Orders: only customer, store owner of the order, or super admin can access
    match /orders/{orderId} {
      allow read: if isAuthenticated() && (
        resource.data.customerId == request.auth.uid ||
        resource.data.storeId == request.auth.token.storeId ||
        isSuperAdmin()
      );
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && (
        resource.data.storeId == request.auth.token.storeId ||
        resource.data.customerId == request.auth.uid ||
        isSuperAdmin()
      );
      allow delete: if isSuperAdmin();
    }

    // Default deny all other operations
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

