# GEMINI_API_KEY: Optional. Required only for Gemini-powered product-description features.
# Configure this directly as a Railway environment variable. Google AI Studio is not part of production.
GEMINI_API_KEY=""

# APP_URL: Public production URL used for links/callbacks.
# Configure this directly in Railway (for example, https://plazado.com).
APP_URL=""

# Production architecture: GitHub -> Railway -> Firestore.
# Firestore remains the production data service; AI Studio has no runtime/IAM role.

# Mail & SMTP Authentication (contacto@plazado.com)
MAIL_SENDER_EMAIL="contacto@plazado.com"
MAIL_SENDER_NAME="PlazaDO.com - Marketplace Dominicano"
SMTP_HOST="smtp.ionos.com"
SMTP_PORT="587"
SMTP_USER="contacto@plazado.com"
SMTP_PASS=""
SESSION_SECRET=""

# Automatic email: MANUAL retains the assisted pilot; RESEND uses HTTPS.
MAIL_PROVIDER="MANUAL"
RESEND_API_KEY=""
# Keep independent from SESSION_SECRET. Preserve an existing encryption key when rotating sessions.
PAYMENT_CREDENTIALS_KEY=""
# Live PayPal webhook configured at https://www.plazado.com/api/paypal/webhook
PAYPAL_WEBHOOK_ID=""
# Private external backup bucket; managed export requires IAM and billing.
FIRESTORE_BACKUP_BUCKET=""
FIRESTORE_BACKUP_OPERATION=""
# Restore is restricted to a different project ending in -restore-test.
FIRESTORE_RESTORE_TEST_PROJECT=""
FIRESTORE_RESTORE_URI=""
